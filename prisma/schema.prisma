generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum StudentLevel {
  UNDERGRADUATE
  MASTER
  DOCTORAL
}

enum LaboratoryType {
  NORMAL
  ADVANCED
  EQUIPMENT
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  DISABLED
}

enum ReservationStatus {
  PENDING_TEACHER
  PENDING_ADMIN
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
  MISSED
}

enum ApprovalType {
  TEACHER
  ADMIN
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum CheckInMethod {
  CODE
  QR
}

enum ViolationType {
  NO_SHOW
  FREQUENT_CANCEL
  UNAUTHORIZED_ACCESS
}

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  passwordHash String
  name         String
  role         UserRole
  status       UserStatus @default(ACTIVE)

  studentNumber String?       @unique
  studentLevel  StudentLevel?

  teacherNumber String? @unique

  teacherId Int?

  teacher  User?  @relation("TeacherStudents", fields: [teacherId], references: [id])
  students User[] @relation("TeacherStudents")

  reservations Reservation[] @relation("StudentReservations")
  approvals    Approval[]    @relation("Approver")
  violations   Violation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([role])
  @@map("users")
}

model Laboratory {
  id          Int            @id @default(autoincrement())
  name        String         @unique
  type        LaboratoryType
  description String?

  openTime  String
  closeTime String

  maxPeople Int

  advanceDays Int @default(7)

  requiresTeacherApproval Boolean @default(false)
  requiresAdminApproval   Boolean @default(false)

  isActive Boolean @default(true)

  equipment    Equipment[]
  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isActive])
  @@map("laboratories")
}

model Equipment {
  id           Int @id @default(autoincrement())
  laboratoryId Int

  name        String
  description String?

  status EquipmentStatus @default(AVAILABLE)

  requirements String?

  requiresTeacherApproval Boolean @default(false)

  minimumStudentLevel StudentLevel?

  laboratory Laboratory @relation(fields: [laboratoryId], references: [id])

  reservationEquipment ReservationEquipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([laboratoryId, name])
  @@index([laboratoryId])
  @@index([status])
  @@map("equipment")
}

model Reservation {
  id           Int @id @default(autoincrement())
  studentId    Int
  laboratoryId Int

  startAt DateTime
  endAt   DateTime

  peopleCount Int
  purpose     String

  status ReservationStatus

  student    User       @relation("StudentReservations", fields: [studentId], references: [id])
  laboratory Laboratory @relation(fields: [laboratoryId], references: [id])

  equipment  ReservationEquipment[]
  approvals  Approval[]
  checkIn    CheckIn?
  violations Violation[]

  cancelledAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([laboratoryId, startAt, endAt])
  @@index([studentId, startAt])
  @@index([status])
  @@map("reservations")
}

model ReservationEquipment {
  reservationId Int
  equipmentId   Int

  reservation Reservation @relation(fields: [reservationId], references: [id])
  equipment   Equipment   @relation(fields: [equipmentId], references: [id])

  @@id([reservationId, equipmentId])
  @@index([equipmentId])
  @@map("reservation_equipment")
}

model Approval {
  id            Int @id @default(autoincrement())
  reservationId Int
  approverId    Int

  type     ApprovalType
  decision ApprovalDecision @default(PENDING)

  comment String?

  reservation Reservation @relation(fields: [reservationId], references: [id])
  approver    User        @relation("Approver", fields: [approverId], references: [id])

  decidedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reservationId, type])
  @@index([approverId])
  @@index([decision])
  @@map("approvals")
}

model CheckIn {
  id            Int @id @default(autoincrement())
  reservationId Int @unique

  method CheckInMethod

  verificationCode String?
  qrToken          String? @unique

  checkedInAt DateTime?

  reservation Reservation @relation(fields: [reservationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("check_ins")
}

model Violation {
  id Int @id @default(autoincrement())

  userId        Int
  reservationId Int?

  type ViolationType

  description String?

  user        User         @relation(fields: [userId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([reservationId])
  @@index([type])
  @@map("violations")
}
